<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YHTransporte.AvaloniaUI.App"
             xmlns:local="using:YHTransporte.AvaloniaUI"
             xmlns:converters="using:YHTransporte.AvaloniaUI.Resources.Converters"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Resources/Styles/InputControls.axaml"/>
        <StyleInclude Source="/Resources/Styles/Collections.axaml"/>
        <StyleInclude Source="/Resources/Styles/Buttons.axaml"/>
    </Application.Styles>

    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources/Themes/MainTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToEmojiConverter x:Key="BoolToEmojiConverter"/>
        </ResourceDictionary>
    </Application.Resources>

    
</Application>