<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YHTransporte.AvaloniaUI.Modules.Dashboard.Views.DashboardMenuView"
             xmlns:vm="using:YHTransporte.AvaloniaUI.Modules.Dashboard.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:DataType="vm:DashboardMenuViewModel">

    <Border Grid.Row="1" Background="{DynamicResource BackgroundColor}" Padding="20">
        <Grid RowDefinitions="110, *">

            <UniformGrid Grid.Row="0" Columns="6" Margin="0,0,0,15">

                <Border Background="#b8d3f3" CornerRadius="8" Margin="5" Padding="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Servicios Pendientes" Foreground="Black" FontSize="11"
                                   HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtServiciosPendientes" Text="0" Foreground="{DynamicResource PrimaryButtonBrush}" FontSize="22"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Por Asignar" Foreground="Gray" FontSize="10" HorizontalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Background="#fed585" CornerRadius="8" Margin="5" Padding="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Servicios en Tránsito" Foreground="Black" FontSize="11"
                                   HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtServiciosTransito" Text="0" Foreground="#ff862f" FontSize="22"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="En ruta" Foreground="Gray" FontSize="10" HorizontalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Background="#9cf2b5" CornerRadius="8" Margin="5" Padding="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Entregas Realizadas" Foreground="Black" FontSize="11"
                                   HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtEntregasRealizadas" Text="0" Foreground="#24b224" FontSize="22"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Este mes" Foreground="Gray" FontSize="10" HorizontalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Background="#e8e8e8" CornerRadius="8" Margin="5" Padding="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Vehículos Disponibles" Foreground="Black" FontSize="11"
                                   HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtVehiculosDisponibles" Text="0" Foreground="#231f20"
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="En Base" Foreground="Gray" FontSize="10" HorizontalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Background="#e8e8e8" CornerRadius="8" Margin="5" Padding="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Conductores Disponibles" Foreground="Black" FontSize="11"
                                   HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtConductoresDisponibles" Text="0" Foreground="#231f20"
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Listos" Foreground="Gray" FontSize="10" HorizontalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Background="#fa8484" CornerRadius="8" Margin="5" Padding="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Incidencias" Foreground="Black" FontSize="11" HorizontalAlignment="Center"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtIncidencias" Text="0" Foreground="#ff0000" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Requieren Atención" Foreground="Gray" FontSize="10" HorizontalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="1" ColumnDefinitions="*, *" RowDefinitions="*, *" Margin="5">
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="8" Margin="5" Padding="15">
                    <Grid RowDefinitions="Auto, *">
                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <TextBlock Text="Resumen de Actividades" Foreground="White"  FontWeight="Bold" FontSize="14" />
                            <ComboBox PlaceholderText="Este mes" Background="White" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" />
                        </Grid>

                        <lvc:CartesianChart Grid.Row="1" Series="{Binding ActivitySeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource PrimaryBrush}" CornerRadius="8" Margin="5" Padding="15">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="Estado de cargas" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />
                        <lvc:PieChart Grid.Row="1" Series="{Binding LoadStatusSeries}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="8" Margin="5" Padding="15">
                    <Grid RowDefinitions="Auto, *, Auto">

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,15">

                            <Border Width="32" Height="32" CornerRadius="25" ClipToBounds="True" >
                                <Image Source="avares://YHTransporte.AvaloniaUI/Assets/ruta.png"
                                       Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="Próximos viajes" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="12">

                            <Grid ColumnDefinitions="Auto, 20, Auto, *, Auto">
                                <TextBlock Grid.Column="0" Text="Managua" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text=" → " Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="León" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="12/03/2025" Foreground="#a0aec0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                                <Border Grid.Column="4" Background="#3b82f6" CornerRadius="12" Padding="10,3">
                                    <TextBlock Text="En tránsito" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="Auto, 20, Auto, *, Auto">
                                <TextBlock Grid.Column="0" Text="Managua" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text=" → " Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Estelí" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="24/07/2026" Foreground="#a0aec0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                                <Border Grid.Column="4" Background="#f59e0b" CornerRadius="12" Padding="10,3">
                                    <TextBlock Text="Pendiente" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="Auto, 20, Auto, *, Auto">
                                <TextBlock Grid.Column="0" Text="Managua" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text=" → " Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Boaco" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="29/12/2026" Foreground="#a0aec0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                                <Border Grid.Column="4" Background="#f59e0b" CornerRadius="12" Padding="10,3">
                                    <TextBlock Text="Pendiente" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                        </StackPanel>

                        <Button Grid.Row="2" Content="Ver todas >" Foreground="#3b82f6" Background="Transparent" FontSize="12" FontWeight="SemiBold"
                                HorizontalAlignment="Right" Margin="0,15,0,0" Cursor="Hand" Command="{Binding OpenCreatorCommand}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource PrimaryBrush}" CornerRadius="8" Margin="5" Padding="15">
                    <Grid RowDefinitions="Auto, *">

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,15">
                            <Border Width="32" Height="32" CornerRadius="25" ClipToBounds="True" >
                                <Image Source="avares://YHTransporte.AvaloniaUI/Assets/advertencia.png"
                                       Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="Incidencias recientes" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="14">

                            <Grid ColumnDefinitions="Auto, 20, Auto, *, Auto">
                                <TextBlock Grid.Column="0" Text="Retraso en entrega" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="-" Foreground="#a0aec0" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Carga #C-1029" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="12/03/2025" Foreground="#a0aec0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                                <Border Grid.Column="4" Background="#ef4444" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock Text="Abierta" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="Auto, 20, Auto, *, Auto">
                                <TextBlock Grid.Column="0" Text="Daño en carga" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="-" Foreground="#a0aec0" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Carga #C-1018" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="21/06/2026" Foreground="#a0aec0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                                <Border Grid.Column="4" Background="#f59e0b" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock Text="En revisión" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="Auto, 20, Auto, *, Auto">
                                <TextBlock Grid.Column="0" Text="Cambio de ruta" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="-" Foreground="#a0aec0" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Carga #C-1025" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="06/02/2026" Foreground="#a0aec0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                                <Border Grid.Column="4" Background="#ef4444" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock Text="Abierta" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
            <UserControl Content="{Binding DashboardListSection}" Grid.RowSpan="2" ZIndex="10"
                        IsVisible="{Binding DashboardListSection.IsOpen}"/>
        </Grid>
    </Border>
</UserControl>