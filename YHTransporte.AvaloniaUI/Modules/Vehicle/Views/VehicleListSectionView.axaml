<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YHTransporte.AvaloniaUI.Modules.Vehicle.Views.VehicleListSectionView"
             xmlns:vm="using:YHTransporte.AvaloniaUI.Modules.Vehicle.ViewModels"
             xmlns:dto="using:YHTransporte.Application.Shipments.Dtos"
             x:DataType="vm:VehicleListSectionViewModel">


    <Grid>

        <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" Padding="25">
            <Grid RowDefinitions="Auto, 24, *">

                <Grid Grid.Row="0" ColumnDefinitions="380, *, Auto" Margin="0,0,0,20">
                    <TextBox Grid.Column="0" PlaceholderText="Buscar por placa o descripción..." Background="White"
                             Foreground="Black" BorderBrush="#374151" CornerRadius="8" Classes="searchbar"
                             VerticalContentAlignment="Center" Height="40" Text="{Binding SearchText}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                        <Button Content="+ Registrar Vehículo" Background="{DynamicResource PrimaryButtonBrush}" Foreground="White"
                                FontWeight="Bold" CornerRadius="8" Height="40" Padding="16,0"
                                VerticalContentAlignment="Center" Command="{Binding OpenCreatorCommand}"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2">
                    <ListBox Background="Transparent" Classes="boring" ItemsSource="{Binding VehicleList}" SelectedItem="{Binding SelectedVehicle}" >

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:VehicleDto">

                                <Border Classes="listItem" DoubleTapped="Vehicle_DoubleTapped">
                                    <Grid RowDefinitions="Auto, *" >

                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,12">
                                            <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='Id: {0}'}" Foreground="#8B93AF" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto, Auto, Auto" VerticalAlignment="Center" Margin="0,0,120,0">

                                            <Border Width="50" Height="50" CornerRadius="25" ClipToBounds="True" >
                                                <Image Source="avares://YHTransporte.AvaloniaUI/Assets/vehiculo.png"
                                                       Stretch="UniformToFill"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4" VerticalAlignment="Center" Margin="15,0,24,0">
                                                <TextBlock Text="{Binding Plate}" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#8B93AF" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Rectangle Grid.Column="2" Width="1" Fill="#323E4D" Margin="21,8"/>

                                            <StackPanel Grid.Column="3"  VerticalAlignment="Center" Spacing="6">
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="Estado: " FontSize="14" Foreground="#8B93AF" VerticalAlignment="Center"/>

                                                    <Border Classes="statusPill" Background="{Binding InUse, Converter={StaticResource StatusToBrushConverter}}">
                                                        <TextBlock Text="{Binding InUse, Converter={StaticResource StatusToTextConverter}}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

            </Grid>
        </Border>

        <UserControl Content="{Binding CreateVehicleList}" ZIndex="10" IsVisible="{Binding CreateVehicleList.IsOpen}"/>
    </Grid>

</UserControl>
