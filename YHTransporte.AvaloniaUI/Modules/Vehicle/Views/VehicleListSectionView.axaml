<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YHTransporte.AvaloniaUI.Modules.Vehicle.Views.VehicleListSectionView"
             xmlns:vm="using:YHTransporte.AvaloniaUI.Modules.Vehicle.ViewModels"
             x:DataType="vm:VehicleListSectionViewModel">


    <Grid>

        <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" Padding="25">
            <Grid RowDefinitions="Auto, 24, *">

                <Grid Grid.Row="0" ColumnDefinitions="380, *, Auto" Margin="0,0,0,20">
                    <TextBox Grid.Column="0" PlaceholderText="Buscar por placa o modelo..." Background="White"
                             Foreground="Black" BorderBrush="#374151" CornerRadius="8" Classes="searchbar"
                             VerticalContentAlignment="Center" Height="40"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                        <Button Content="+ Registrar Vehículo" Background="{DynamicResource PrimaryButtonBrush}" Foreground="White"
                                FontWeight="Bold" CornerRadius="8" Height="40" Padding="16,0"
                                VerticalContentAlignment="Center" Command="{Binding OpenCreatorCommand}"/>

                        <Button Content="Ordenar" Background="{DynamicResource PrimaryButtonBrush}" Foreground="White"
                                FontWeight="Bold" CornerRadius="8" Height="40" Padding="16,0"
                                VerticalContentAlignment="Center"/>

                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2">
                    <ListBox Background="Transparent" Classes="boring" ItemsSource="True" SelectedItem="True" >

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Background="{DynamicResource PrimaryBrush}" Padding="20" CornerRadius="12" Margin="0,0,0,16" DoubleTapped="Vehicle_DoubleTapped">
                                    <Grid RowDefinitions="Auto, *" >

                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,12">
                                            <TextBlock Grid.Column="0" Text="Placa" Foreground="#8B93AF" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>

                                            <Button Grid.Column="2" Background="{DynamicResource PrimaryDeclineButtonBrush}" Foreground="White" Width="28" Height="28" CornerRadius="14" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                <TextBlock Text="X" FontSize="11" FontWeight="Bold"/>
                                            </Button>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto, Auto, Auto" VerticalAlignment="Center" Margin="0,0,120,0">

                                            <Border Width="50" Height="50" CornerRadius="25" ClipToBounds="True" >
                                                <Image Source="avares://YHTransporte.AvaloniaUI/Assets/vehiculo.png"
                                                       Stretch="UniformToFill"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4" VerticalAlignment="Center" Margin="15,0,24,0">
                                                <TextBlock Text="Nombre" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="Capacidad" Foreground="#8B93AF" FontSize="14"/>
                                                <TextBlock Text="Combustible" Foreground="#8B93AF" FontSize="14"/>
                                            </StackPanel>

                                            <Rectangle Grid.Column="2" Width="1" Fill="#323E4D" Margin="21,8"/>

                                            <StackPanel Grid.Column="3"  VerticalAlignment="Center" Spacing="6">
                                                <TextBlock Text="Año" Foreground="#8B93AF" FontSize="14" />

                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="Estado: " FontSize="14" Foreground="#8B93AF" VerticalAlignment="Center"/>

                                                    <Border Background="#108043" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                                        <TextBlock Text="Disponible" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

            </Grid>
        </Border>

        <UserControl Content="{Binding CreateVehicleList}" ZIndex="10" IsVisible="{Binding CreateVehicleList.IsOpen}"/>
    </Grid>

</UserControl>