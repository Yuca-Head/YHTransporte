<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YHTransporte.AvaloniaUI.Modules.Vehicle.Views.VehicleEditorView"
             xmlns:vm="using:YHTransporte.AvaloniaUI.Modules.Vehicle.ViewModels"
             x:DataType="vm:VehicleEditorViewModel">

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource BackgroundBrush}" Padding="25">
            <Grid RowDefinitions="Auto, *, Auto">

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Button Content="Regresar" Foreground="White" FontWeight="Bold" CornerRadius="8"
                            Padding="15,10" FontSize="14" Margin="0,0,20,0" Classes="warning" Command="{Binding ExitCommand}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,20">

                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="20" Margin="0,0,20,0">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Información del Vehículo" Foreground="White" FontWeight="Bold" FontSize="15"/>

                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                                    <TextBlock Text="Placa / Matrícula" Foreground="White" FontSize="11"/>
                                    <TextBox  PlaceholderText="Ej. M 123-456" Background="White" Foreground="Black" CornerRadius="8" Height="35"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Marca/Modelo" Foreground="White" FontSize="11"/>
                                    <TextBox  PlaceholderText="Ej. Freightliner M2" Background="White" Foreground="Black" CornerRadius="8" Height="35"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                                    <TextBlock Text="Capacidad de Carga" Foreground="White" FontSize="11"/>
                                    <TextBox  PlaceholderText="Ej. 5 Toneladas" Background="White" Foreground="Black" CornerRadius="8" Height="35"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Año" Foreground="White" FontSize="11"/>
                                    <TextBox  PlaceholderText="Ej. 2022" Background="White" Foreground="Black" CornerRadius="8" Height="35"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                                    <TextBlock Text="Tipo de Combustible" Foreground="White" FontSize="11"/>
                                    <ComboBox Background="White" Foreground="Black" CornerRadius="8" Height="35" HorizontalAlignment="Stretch"  />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Estado" Foreground="White" FontSize="11"/>
                                    <ComboBox Background="White" Foreground="Black" CornerRadius="8" Height="35" HorizontalAlignment="Stretch"  />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,5,0,0">
                                <Button Content="Guardar Cambios" Background="{DynamicResource PrimaryButtonBrush}" Foreground="White"
                                        FontWeight="Bold" CornerRadius="8" Padding="20,8"/>
                                <Button Content="Limpiar Campos" Background="#374151" Foreground="White"
                                        FontWeight="Bold" CornerRadius="8" Padding="20,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
