<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YHTransporte.AvaloniaUI.Modules.Vehicle.Views.CreateVehicleView"
             xmlns:vm="using:YHTransporte.AvaloniaUI.Modules.Vehicle.ViewModels"
             x:DataType="vm:CreateVehicleViewModel">

    <Grid>
        <Border Classes="popup">

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Registrar Nuevo Vehículo" Foreground="White" FontSize="20"
                                   FontWeight="Bold"/>

                        <Button Grid.Column="1" Content="X" Background="Transparent" Foreground="#DA1212"
                                FontSize="16" Padding="5" Cursor="Hand" Command="{Binding CloseCommand}"/>
                    </Grid>

                    <!--CAMBIO: solo se dejan los campos que existen en dbo.Vehicles (Plate, Description)-->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="Placa / Matrícula *"/>
                        <TextBox Classes="searchbar" PlaceholderText="Ej. M 123-456" Text="{Binding Plate}" MaxLength="25"
                        CornerRadius="8" Height="35" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="Descripción (marca, modelo, capacidad, observaciones...)"/>
                        <TextBox Classes="searchbar" PlaceholderText="Ej. Freightliner M2 - 5 toneladas" Text="{Binding Description}"
                        MaxLength="120" CornerRadius="8" Height="60" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Classes="result" Text="{Binding ResultManager.ResultMessage}" x:Name="ResultTextBlock"/>

                    <Grid ColumnDefinitions="*, 12, *" Margin="0,15,0,0">
                        <Button Grid.Column="0" Content="Guardar" Background="{DynamicResource PrimaryButtonBrush}"
                                Foreground="White" FontWeight="Bold" Height="40" CornerRadius="6" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding CreateCommand}"/>

                        <Button Grid.Column="2" Content="Cancelar" Background="{DynamicResource PrimaryDeclineButtonBrush}"
                                Foreground="White" FontWeight="Bold" Height="40" CornerRadius="6" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding CloseCommand}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
