<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:YHTransporte.AvaloniaUI.Modules.Reports.ViewModels"
    xmlns:rep="using:YHTransporte.Application.Reports"
    x:Class="YHTransporte.AvaloniaUI.Modules.Reports.Views.ReportsMenuView"
    x:DataType="vm:ReportsMenuViewModel">

    <Border Background="{DynamicResource BackgroundBrush}" Padding="25">
        <Grid RowDefinitions="Auto, Auto, Auto, *" RowSpacing="15">

            <TextBlock Grid.Row="0" Text="Reporte de envíos" Foreground="White" FontWeight="Bold" FontSize="20"/>

            <!-- Filtros -->
            <Border Grid.Row="1" Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="20">
                <Grid ColumnDefinitions="*, *, *, *, Auto" ColumnSpacing="12">

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Desde" Foreground="White" FontSize="11"/>
                        <CalendarDatePicker SelectedDate="{Binding FromDate}" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Hasta" Foreground="White" FontSize="11"/>
                        <CalendarDatePicker SelectedDate="{Binding ToDate}" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Estado del envío" Foreground="White" FontSize="11"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}" Classes="common" SelectedItem="{Binding SelectedStatus}"
                                  Background="White" Foreground="Black" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="rep:ReportOption">
                                    <TextBlock Text="{Binding Name}" Foreground="Black"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="4">
                        <TextBlock Text="Proveedor" Foreground="White" FontSize="11"/>
                        <ComboBox ItemsSource="{Binding SupplierOptions}" Classes="common" SelectedItem="{Binding SelectedSupplier}"
                                  Background="White" Foreground="Black" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="rep:ReportOption">
                                    <TextBlock Text="{Binding Name}" Foreground="Black"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="Generar" Command="{Binding GenerateCommand}"
                                Background="#0056D6" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="18,8"/>
                        <Button Content="Cancelar" Command="{Binding GenerateCancelCommand}"
                                Background="#F14D1F" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="18,8"/>
                        <Button Content="Limpiar" Command="{Binding ClearFiltersCommand}"
                                Background="#374151" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="18,8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Estado de la operación -->
            <StackPanel Grid.Row="2" Spacing="6">
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#9ca3af" FontSize="12"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#ef4444" FontWeight="Bold" FontSize="12"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>

            <!-- Resultados -->
            <Grid Grid.Row="3" RowDefinitions="Auto, *" RowSpacing="15">

                <!-- Totales por estado (en una franja arriba de la tabla) -->
                <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="20,12">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <TextBlock Text="Totales por estado" Foreground="White" FontWeight="Bold" FontSize="15"
                                   VerticalAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding Summary}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="25"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rep:ShipmentStatusSummary">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Status}" Foreground="#38bdf8" FontWeight="Bold"/>
                                        <TextBlock Foreground="White" FontSize="12">
                                            <Run Text="{Binding Shipments}"/><Run Text=" envíos · "/><Run Text="{Binding Packages}"/><Run Text=" paq. · "/><Run Text="{Binding TotalWeightKg, StringFormat='{}{0:N2}'}"/><Run Text=" kg"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Sin datos" Foreground="#9ca3af" VerticalAlignment="Center"
                                   IsVisible="{Binding IsEmpty}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="15">
                    <Grid RowDefinitions="Auto, Auto, *, Auto">

                        <Grid Grid.Row="0" Background="{DynamicResource BackgroundBrush}" Height="35"
                              ColumnDefinitions="105, 105, *, *, 85, 95, 105, 95, 55, 85">
                            <TextBlock Grid.Column="0" Text="Envío" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBlock Grid.Column="1" Text="Orden" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Proveedor" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Cliente" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Estado" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="Creada" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="Recogida" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="Entregado" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="Paq." Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="9" Text="Kg" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="Sin resultados con esos filtros." Foreground="#9ca3af" Margin="10,12"
                                   IsVisible="{Binding IsEmpty}"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="rep:ShipmentReportRow">
                                        <Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid ColumnDefinitions="105, 105, *, *, 85, 95, 105, 95, 55, 85">
                                                <TextBlock Grid.Column="0" Text="{Binding ShipmentCode}" Foreground="White" Margin="10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding OrderCode}" Foreground="White"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SupplierName}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding CustomerName}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="#38bdf8" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="5" Text="{Binding OrderCreatedAt, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="White"/>
                                                <TextBlock Grid.Column="6" Text="{Binding EstimatedPickupAt, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="White"/>
                                                <TextBlock Grid.Column="7" Text="{Binding DeliveredAt, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="White"/>
                                                <TextBlock Grid.Column="8" Text="{Binding PackageCount}" Foreground="White"/>
                                                <TextBlock Grid.Column="9" Text="{Binding TotalWeightKg, StringFormat='{}{0:N2}'}" Foreground="White"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="3" Text="{Binding TotalsText}" Foreground="White" FontWeight="Bold" Margin="10,10,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
