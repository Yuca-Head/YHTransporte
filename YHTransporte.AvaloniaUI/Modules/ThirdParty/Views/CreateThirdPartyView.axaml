<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="YHTransporte.AvaloniaUI.Modules.ThirdParty.Views.CreateThirdPartyView"
    xmlns:vm="using:YHTransporte.AvaloniaUI.Modules.ThirdParty.ViewModels"
    x:DataType="vm:CreateThirdPartyViewModel">

    
    <Border Background="{DynamicResource BackgroundBrush}" 
    BorderBrush="{DynamicResource PrimaryButtonBrush}" BorderThickness="1"  Height="350"
    CornerRadius="10" Padding="24" Width="380">
        <StackPanel Spacing="16">
            <TextBlock Text="Registrar Nuevo Tercero"  FontSize="18" FontWeight="Bold"/>

            <StackPanel Spacing="6" >
                <TextBlock Text="Nombre / Razón Social *" Foreground="#CCD6F6" FontSize="16"/>
                <TextBox Classes="searchbar" PlaceholderText="Ej. Juan Francisco" Text="{Binding NewThirdParty.Name}" Background="White" 
                BorderBrush="{DynamicResource PrimaryButtonBrush}" CornerRadius="6"
                Height="38" VerticalContentAlignment="Center"/>

                <Grid ColumnDefinitions="*, *" Margin="0,20,0,0">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Rol de Proveedor" Foreground="#CCD6F6" FontSize="16"/>
                        <ToggleSwitch HorizontalAlignment="Center" IsChecked="{Binding NewThirdParty.IsSupplier}"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Grid.Column="1">
                        <TextBlock Text="Rol de Cliente" Foreground="#CCD6F6" FontSize="16"/>
                        <ToggleSwitch HorizontalAlignment="Center" IsChecked="{Binding NewThirdParty.IsCustomer}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <TextBlock  Grid.ColumnSpan="2" TextWrapping="Wrap" x:Name="ResultTextBlock"
            Text="{Binding ResultMessage}" Grid.Row="1"/>

            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*, 12, *">
                    <Button Grid.Column="0" Content="Cancelar" Background="{DynamicResource PrimaryDeclineButtonBrush}" Foreground="#CCD6F6" FontWeight="Bold"
                    CornerRadius="6" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center" Command="{Binding CloseCommand}"/>

                    <Button Grid.Column="2" Content="Guardar" Background="{DynamicResource PrimaryButtonBrush}"  FontWeight="Bold"
                    CornerRadius="6" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center" Command="{Binding CreateCommand}"/>
                </Grid>
            </StackPanel>
                
        </StackPanel>
    </Border>


</UserControl>
