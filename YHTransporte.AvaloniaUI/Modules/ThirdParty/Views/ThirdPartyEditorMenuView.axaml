<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="YHTransporte.AvaloniaUI.Modules.ThirdParty.Views.ThirdPartyEditorMenuView"
    xmlns:vm="using:YHTransporte.AvaloniaUI.Modules.ThirdParty.ViewModels"
    x:DataType="vm:ThirdPartyEditorMenuViewModel">
    
    <ScrollViewer Background="Aqua">
        <Grid>
            <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" Padding="25">

                <Grid RowDefinitions="Auto, *, Auto">

                    <Grid Grid.Row="0" Margin="0,0,0,20" ColumnDefinitions="Auto, 3*, *, *">
                            
                        <Button Content="Regresar" Foreground="White" FontWeight="Bold" CornerRadius="8" 
                        Padding="15,10" FontSize="14"  Margin="0,0,20,0" Classes="warning" Command="{Binding ExitCommand}" />

                        <Button Grid.Column="2" Margin="10, 0" Content="Agregar Departamento" Background="#181F2C" Foreground="Gray"
                        FontWeight="Bold" Command="{Binding OpenDepartmentCreatorCommand}" CornerRadius="8,8,0,0" Padding="14,8"/>

                        <Button Grid.Column="3" Margin="10, 0" Content="Agregar Municipio"
                        Foreground="White" FontWeight="Bold" Command="{Binding OpenMunicipalityCreatorCommand}" CornerRadius="8,8,0,0" Padding="14,8"/>

                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="440, *">

                        <StackPanel Grid.Column="0" Spacing="15" Margin="0,0,15,0">
                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Información Básica" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                    <Grid ColumnDefinitions="Auto, *">

                                        <Ellipse Grid.Column="0" Width="60" Height="60" Fill="#374151" Margin="0,0,15,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding ThirdParty.Key, StringFormat='Id: {0}'}" Foreground="Gray" FontSize="11"/>
                                            <TextBlock Text="{Binding ThirdParty.Name}" Foreground="White" FontWeight="Bold" FontSize="15"/>
                                            <TextBlock Text="Cédula" Foreground="Gray" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Height="50" Padding="20">
                                <!--StackPanel Spacing="0">
                                    <TextBlock Text="Datos de Contacto" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                    <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,5,0,0">
                                        <TextBlock Text="**** - ****" Foreground="LightGray" VerticalAlignment="Center"/>
                                        <TextBlock Text="****@gmail.com" Foreground="LightGray" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel-->
                            </Border>

                            
                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="20">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="Direcciones Registradas" Foreground="White" FontWeight="Bold"
                                                    FontSize="14" VerticalAlignment="Center"/>
                                        <Button Command="{Binding ShowAddAddressCommand}" Grid.Column="1" Content="+ Añadir Dirección"
                                                Background="{DynamicResource PrimaryButtonBrush}" Foreground="White" FontSize="11" FontWeight="Bold" CornerRadius="6"
                                                Padding="10,4"/>
                                    </Grid>

                                    <StackPanel Tag="PanelNewAddress" IsVisible="{Binding IsAddAddressOptionOpen}"  Spacing="6" Margin="0,2,0,5">
                                        <TextBlock Text="Nueva Dirección" Foreground="#CCD6F6" FontSize="12" FontWeight="Bold"/>

                                        <Grid ColumnDefinitions="*, 8, *">
                                            <ComboBox Grid.Column="0" PlaceholderText="Departamento" Classes="common" PlaceholderForeground="Black"
                                            FontSize="14" CornerRadius="4" Height="30" ItemsSource="{Binding AddressCreator.Departments}" SelectedItem="{Binding AddressCreator.SelectedDepartment}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="14"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ComboBox Grid.Column="2" PlaceholderText="Municipio" Classes="common" SelectedItem="{Binding AddressCreator.SelectedMunicipality}"
                                            FontSize="14" CornerRadius="4" Height="30" PlaceholderForeground="Black" ItemsSource="{Binding AddressCreator.Municipalities}">
                                                <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" FontSize="14"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                            </ComboBox>     
                                        </Grid>

                                        <TextBox Classes="searchbar" PlaceholderText="Dirección " FontSize="11" CornerRadius="4"
                                                    Height="35" Text="{Binding AddressCreator.NewAddress}"/>
                                        <TextBlock Text="{Binding AddressCreator.ResultManager.ResultMessage}" x:Name="AddressResultMessage" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button Content="Cancelar" Command="{Binding CancelAddAddressCommand}"
                                             Background="{DynamicResource PrimaryDeclineButtonBrush}" Foreground="LightGray"
                                                    FontSize="10" CornerRadius="4" Padding="8,3"/>
                                            <Button Content="Guardar" Background="{DynamicResource PrimaryButtonBrush}" Foreground="White"
                                                    FontSize="10" CornerRadius="4" Padding="8,3" Command="{Binding AddressCreator.CreateCommand}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Separator Background="#374151" Height="1" Margin="0,2"/>

                                    <StackPanel Spacing="8">
                                        <ItemsControl ItemsSource="{Binding AddressCreator.ThirdPartyAddresses}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <Border Background="#111827" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                                        <Grid ColumnDefinitions="*, Auto">
                                                            <StackPanel Grid.Column="0" Spacing="2" >
                                                                <TextBlock Text="{Binding Name, StringFormat='Dirección: {0}'}" Foreground="White"
                                                                            FontSize="12" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Municipality.Name, StringFormat='Municipio: {0}'}" 
                                                                Foreground="#34d399" FontSize="10" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding Municipality.Department.Name, StringFormat='Departamento: {0}'}" 
                                                                Foreground="#34d399" FontSize="10" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>


                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1" Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Historial de Fletes Recientes" Foreground="White" FontWeight="Bold" FontSize="14"/>

                                <Grid Margin="0,5,0,5" ColumnDefinitions="*, *,120, 100">

                                    <TextBlock Grid.Column="0" Text="Carga" Foreground="Gray" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="Ruta" Foreground="Gray" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="2" Text="Estado" Foreground="Gray" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Fecha" Foreground="Gray" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Separator Background="#374151" Height="1"/>

                                <Grid Margin="0,5" ColumnDefinitions="*, *, 120, 100">

                                    <TextBlock Grid.Column="0" Text="C-1345" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Managua → León" Foreground="LightGray" VerticalAlignment="Center"/>

                                    <Border Grid.Column="2" Background="#065f46" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                        <TextBlock Text="En tránsito" Foreground="#34d399" FontSize="11" FontWeight="Bold"/>
                                    </Border>

                                    <TextBlock Grid.Column="3" Text="06/02/2026" Foreground="LightGray" VerticalAlignment="Center"
                                                HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,5" ColumnDefinitions="*, *, 120, 100">

                                    <TextBlock Grid.Column="0" Text="C-1033" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Managua → León" Foreground="LightGray" FontWeight="Bold"
                                                VerticalAlignment="Center"/>

                                    <Border Grid.Column="2" Background="#065f46" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                        <TextBlock Text="Entregado" Foreground="#34d399" FontSize="11" FontWeight="Bold"/>
                                    </Border>

                                    <TextBlock Grid.Column="3" Text="24/02/2024" Foreground="LightGray" VerticalAlignment="Center"
                                                HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Content="Guardar Cambios" Background="{DynamicResource PrimaryButtonBrush}" Foreground="White"
                                FontWeight="Bold" CornerRadius="8" Padding="20,10"/>
                        <Button Content="Eliminar Cliente" Background="{DynamicResource PrimaryDeclineButtonBrush}" Foreground="White"
                                FontWeight="Bold" CornerRadius="8" Padding="20,10"/>
                        <Button Content="Restablecer Campos" Background="{DynamicResource SecondaryButtonBrush}" Foreground="LightGray"
                                FontWeight="Bold" CornerRadius="8" Padding="20,10"/>

                    </StackPanel>
                </Grid>
            </Border>
      

                <UserControl Content="{Binding CurrentPopup}" ZIndex="100" IsVisible="{Binding AnyPopupIsOpen}"/>
        </Grid>
    </ScrollViewer>
</UserControl>