<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="YHTransporte.AvaloniaUI.Modules.ThirdParty.Views.ThirdPartyMenuView"
    xmlns:vm="using:YHTransporte.AvaloniaUI.Modules.ThirdParty.ViewModels"
    x:DataType="vm:ThirdPartyMenuViewModel">
    <Grid>
        <UserControl Content="{Binding CurrentView}" />
    </Grid>
</UserControl>