<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YHTransporte.AvaloniaUI.Modules.Shipment.Views.CreateShipmentView"
             xmlns:vm="using:YHTransporte.AvaloniaUI.Modules.Shipment.ViewModels"
             x:DataType="vm:CreateShipmentViewModel">

    <Grid>
        <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource PrimaryButtonBrush}"
                BorderThickness="1.5" CornerRadius="10" Width="480" HorizontalAlignment="Center"
                VerticalAlignment="Center" Padding="25">

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Registrar Nuevo Envío" Foreground="White" FontSize="20"
                                   FontWeight="Bold"/>

                        <Button Grid.Column="1" Content="X" Background="Transparent" Foreground="#DA1212"
                                FontSize="16" Padding="5" Cursor="Hand"/>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Cliente *" Foreground="#8A92A6" FontSize="13"/>
                        <ComboBox PlaceholderText="Seleccionar cliente..." HorizontalAlignment="Stretch" Background="White"
                                  Foreground="Black" CornerRadius="6" Height="38"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Remitente *" Foreground="#8A92A6" FontSize="13"/>
                        <ComboBox PlaceholderText="Seleccionar remitente..." HorizontalAlignment="Stretch" Background="White"
                                  Foreground="Black" CornerRadius="6" Height="38"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Fecha Solicitud" Foreground="#8A92A6" FontSize="13"/>
                        <DatePicker Background="White" CornerRadius="6" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Fecha Estimada" Foreground="#8A92A6" FontSize="13"/>
                        <DatePicker Background="White" CornerRadius="6" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, 12, *" Margin="0,15,0,0">
                        <Button Grid.Column="0" Content="Guardar" Background="{DynamicResource PrimaryButtonBrush}"
                                Foreground="White" FontWeight="Bold" Height="40" CornerRadius="6" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>

                        <Button Grid.Column="2" Content="Cancelar" Background="{DynamicResource PrimaryDeclineButtonBrush}"
                                Foreground="White" FontWeight="Bold" Height="40" CornerRadius="6" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
