<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YHTransporte.AvaloniaUI.Modules.Shipment.Views.ShipmentEditorView"
             xmlns:vm="using:YHTransporte.AvaloniaUI.Modules.Shipment.ViewModels"
             xmlns:dto="using:YHTransporte.Application.Shipments.Dtos"
             x:DataType="vm:ShipmentEditorViewModel">

    <Border Classes="card" Padding="20">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto">

            <!--Barra superior del envío-->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,12">
                <Button Content="Volver a Envíos" Foreground="White" FontWeight="Bold" CornerRadius="8"
                Padding="15,8" Margin="0,0,20,0" Classes="warning" Command="{Binding ExitCommand}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Shipment.Key, StringFormat='Envío N° {0}'}" Foreground="White" FontWeight="Bold"
                    FontSize="17" VerticalAlignment="Center"/>
                    <Border Classes="statusPill" Background="{Binding Shipment.Status, Converter={StaticResource StatusToBrushConverter}}">
                        <TextBlock Text="{Binding Shipment.Status, Converter={StaticResource StatusToTextConverter}}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Classes="action" Content="{Binding NextStatusText}" Background="{DynamicResource PrimaryButtonBrush}"
                    Command="{Binding AdvanceStatusCommand}" IsVisible="{Binding CanAdvanceStatus}"/>
                    <Button Classes="action" Content="Cancelar Envío" Background="{DynamicResource PrimaryDeclineButtonBrush}"
                    Command="{Binding CancelShipmentCommand}" IsVisible="{Binding CanCancel}"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Classes="result" Margin="0,0,0,12" x:Name="ResultTextBlock"
            Text="{Binding ResultManager.ResultMessage}"/>

            <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="20" Margin="0,0,0,20">

                <!--Información general (solo lectura)-->
                <Border Grid.Column="0" Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="cardTitle" Text="Información del Envío"/>

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="12" ColumnSpacing="16">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Classes="infoLabel" Text="Conductor"/>
                                <TextBlock Classes="infoValue" Text="{Binding Shipment.Driver.FullName, FallbackValue='Sin asignar'}"/>
                                <TextBlock Classes="infoLabel" Text="{Binding Shipment.Driver.Code}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock Classes="infoLabel" Text="Vehículo"/>
                                <TextBlock Classes="infoValue" Text="{Binding Shipment.Vehicle.Plate, FallbackValue='Sin asignar'}"/>
                                <TextBlock Classes="infoLabel" Text="{Binding Shipment.Vehicle.Description}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                <TextBlock Classes="infoLabel" Text="Recogida Estimada"/>
                                <TextBlock Classes="infoValue" Text="{Binding Shipment.EstimatedPickUpAt, StringFormat='{}{0:dd/MM/yyyy}', TargetNullValue='-'}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Classes="infoLabel" Text="Recogido (salida)"/>
                                <TextBlock Classes="infoValue" Text="{Binding Shipment.PickedUpAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='-'}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                <TextBlock Classes="infoLabel" Text="Entregado"/>
                                <TextBlock Classes="infoValue" Text="{Binding Shipment.DeliveredAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='-'}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                <TextBlock Classes="infoLabel" Text="Carga"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="infoValue" Text="{Binding Shipment.PackageCount, StringFormat='{}{0} paquete(s)'}"/>
                                    <TextBlock Classes="infoValue" Text="{Binding Shipment.TotalWeight, StringFormat='· {0:N2} kg'}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4">
                                <TextBlock Classes="infoLabel" Text="Descripción"/>
                                <TextBlock Classes="infoValue" Text="{Binding Shipment.Description}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--Edición (solo mientras el envío no ha partido)-->
                <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="cardTitle" Text="Editar Envío"/>

                        <TextBlock Text="El envío ya partió o la orden está terminada: no se puede modificar."
                        Foreground="#9ca3af" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !CanEdit}"/>

                        <StackPanel Spacing="10" IsEnabled="{Binding CanEdit}">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="Conductor"/>
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <ComboBox PlaceholderText="Sin asignar" Classes="common" HorizontalAlignment="Stretch" CornerRadius="8" Height="35"
                                    ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="dto:DriverDto">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Code}" Foreground="#8A92A6"/>
                                                    <TextBlock Text="{Binding FullName}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" Classes="circleClear" Command="{Binding ClearDriverCommand}" ToolTip.Tip="Quitar conductor">
                                        <TextBlock Text="X" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="Vehículo"/>
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <ComboBox PlaceholderText="Sin asignar" Classes="common" HorizontalAlignment="Stretch" CornerRadius="8" Height="35"
                                    ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="dto:VehicleDto">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Plate}"/>
                                                    <TextBlock Text="{Binding Description, StringFormat='- {0}'}" Foreground="#8A92A6"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" Classes="circleClear" Command="{Binding ClearVehicleCommand}" ToolTip.Tip="Quitar vehículo">
                                        <TextBlock Text="X" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="Fecha Estimada de Recogida"/>
                                <CalendarDatePicker Classes="common" Height="35" SelectedDate="{Binding EstimatedPickUpDate}"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="Descripción"/>
                                <TextBox Classes="searchbar" Text="{Binding Description}" MaxLength="120" CornerRadius="8" Height="50" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,5,0,0">
                                <Button Classes="action" Content="Guardar Cambios" Background="{DynamicResource PrimaryButtonBrush}"
                                Command="{Binding SaveChangesCommand}"/>
                                <Button Classes="action" Content="Restablecer Campos" Background="{DynamicResource SecondaryButtonBrush}"
                                Command="{Binding ResetFieldsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!--Paquetes del envío-->
            <UserControl Grid.Row="3" Content="{Binding PackageMenu}"/>
        </Grid>
    </Border>
</UserControl>
