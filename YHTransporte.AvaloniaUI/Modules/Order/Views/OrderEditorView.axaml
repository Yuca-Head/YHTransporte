<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="YHTransporte.AvaloniaUI.Modules.Order.Views.OrderEditorView"
    xmlns:vm="using:YHTransporte.AvaloniaUI.Modules.Order.ViewModels"
    x:DataType="vm:OrderEditorViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource BackgroundBrush}" Padding="25">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto">

                <!--Barra superior: regresar, código/estado y acciones de la orden-->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,12">

                    <Button Content="Regresar" Foreground="White" FontWeight="Bold" CornerRadius="8"
                    Padding="15,10" FontSize="14" Margin="0,0,20,0" Classes="warning" Command="{Binding CloseCommand}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Order.Code, StringFormat='Orden N° {0}'}" Foreground="White" FontWeight="Bold"
                        FontSize="20" VerticalAlignment="Center"/>
                        <Border Classes="statusPill" Background="{Binding Order.Status, Converter={StaticResource StatusToBrushConverter}}">
                            <TextBlock Text="{Binding Order.Status, Converter={StaticResource StatusToTextConverter}}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                        <Button Classes="action" Content="{Binding NextStatusText}" Background="{DynamicResource PrimaryButtonBrush}"
                        Command="{Binding AdvanceStatusCommand}" IsVisible="{Binding CanAdvanceStatus}"/>

                        <Button Classes="action" Content="Cancelar Orden" Background="{DynamicResource PrimaryDeclineButtonBrush}"
                        Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}"/>

                        <Button Classes="action warning" Content="Forzar Cancelación" Background="{DynamicResource SecondaryButtonBrush}"
                        Command="{Binding ForceCancelCommand}" IsVisible="{Binding CanForceCancel}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Classes="result" Margin="0,0,0,12" x:Name="ResultTextBlock"
                Text="{Binding ResultManager.ResultMessage}"/>

                <Grid Grid.Row="2" Margin="0,0,0,20" ColumnDefinitions="*, 380">

                    <!--Información general-->
                    <Border Grid.Column="0" Classes="card" Margin="0,0,20,0">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="cardTitle" Text="Información General"/>

                            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="14" ColumnSpacing="20">

                                
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="infoLabel" Text="Proveedor (Remitente)"/>
                                    <TextBlock Classes="infoValue" Text="{Binding Supplier.Name, FallbackValue='-'}"/>
                                </StackPanel>
                                    
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="infoLabel" Text="Cliente"/>
                                    <TextBlock Classes="infoValue" Text="{Binding Customer.Name, FallbackValue='-'}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="infoLabel" Text="Origen"/>
                                    <TextBlock Classes="infoValue" Text="{Binding Order.Origin.Name}"/>
                                    <TextBlock Foreground="#34d399" FontSize="11" FontWeight="Bold"
                                    Text="{Binding Order.Origin.Municipality.Name, StringFormat='Municipio: {0}'}"/>
                                    <TextBlock Foreground="#34d399" FontSize="11" FontWeight="Bold"
                                    Text="{Binding Order.Origin.Municipality.Department.Name, StringFormat='Departamento: {0}'}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="infoLabel" Text="Destino"/>
                                    <TextBlock Classes="infoValue" Text="{Binding Order.Destination.Name}"/>
                                    <TextBlock Foreground="#34d399" FontSize="11" FontWeight="Bold"
                                    Text="{Binding Order.Destination.Municipality.Name, StringFormat='Municipio: {0}'}"/>
                                    <TextBlock Foreground="#34d399" FontSize="11" FontWeight="Bold"
                                    Text="{Binding Order.Destination.Municipality.Department.Name, StringFormat='Departamento: {0}'}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="infoLabel" Text="Fecha de Creación"/>
                                    <TextBlock Classes="infoValue" Text="{Binding Order.CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="infoLabel" Text="Descripción"/>
                                    <TextBlock Classes="infoValue" Text="{Binding Order.Description}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--Resumen de envíos-->
                    <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="cardTitle" Text="Resumen de Envíos"/>

                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Classes="infoLabel" FontSize="12" Text="Envíos registrados" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="infoValue" Text="{Binding TotalShipments}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Classes="infoLabel" FontSize="12" Text="Activos (pendientes / en camino)" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="infoValue" Text="{Binding ActiveShipments}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Classes="infoLabel" FontSize="12" Text="Entregados" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="infoValue" Text="{Binding DeliveredShipments}"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#374151" Margin="0,2"/>

                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Classes="infoLabel" FontSize="12" Text="Paquetes (sin cancelados)" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="infoValue" Text="{Binding TotalPackages}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Classes="infoLabel" FontSize="12" Text="Peso total" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="infoValue" Text="{Binding TotalWeight, StringFormat='{}{0:N2} kg'}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--Envíos de la orden (lista / editor)-->
                <UserControl Grid.Row="3" Content="{Binding ShipmentMenu}"/>

            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
