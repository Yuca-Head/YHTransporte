<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            x:Class="YHTransporte.AvaloniaUI.Modules.Order.Views.OrderListSectionView"
            xmlns:vm="using:YHTransporte.AvaloniaUI.Modules.Order.ViewModels"
            xmlns:models="using:YHTransporte.AvaloniaUI.Modules.Order.Models"
            x:DataType="vm:OrderListSectionViewModel">

    <Grid>
        <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" Padding="25">
            <Grid RowDefinitions="Auto, 24, *">

                <Grid Grid.Row="0" ColumnDefinitions="380, *, Auto" Margin="0,0,0,20">
                    <TextBox Grid.Column="0" PlaceholderText="Buscar por código" Background="White"
                    Foreground="Black" BorderBrush="#374151" CornerRadius="8" Classes="searchbar"
                    VerticalContentAlignment="Center" Height="40"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                        <Button Content="+ Crear Nuevo Servicio" Background="{DynamicResource PrimaryButtonBrush}" Foreground="White"
                        FontWeight="Bold" CornerRadius="8" Height="40" Padding="16,0" Command="{Binding Creator.OpenCommand}"
                        VerticalContentAlignment="Center"/>

                        <Button Content="Ordenar" Background="{DynamicResource PrimaryButtonBrush}" Foreground="White"
                                FontWeight="Bold" CornerRadius="8" Height="40" Padding="16,0"
                                VerticalContentAlignment="Center"/>

                    </StackPanel>
                </Grid>


                <ScrollViewer Grid.Row="2">
                    <ListBox Background="Transparent" Classes="boring" ItemsSource="{Binding OrderList}" SelectedItem="{Binding SelectedOrder}" >


                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:OrderDetailsVM">

                                <Border Classes="listItem" DoubleTapped="Order_DoubleTapped">
                                    <Grid RowDefinitions="Auto, *" >

                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,12">
                                            <TextBlock Grid.Column="0" Text="{Binding Dto.Code}" Foreground="#8B93AF" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>

                                            <Border Grid.Column="2" Classes="statusPill" Background="{Binding Dto.Status, Converter={StaticResource StatusToBrushConverter}}">
                                                <TextBlock Text="{Binding Dto.Status, Converter={StaticResource StatusToTextConverter}}"/>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto, Auto, Auto" VerticalAlignment="Center" Margin="0,0,120,0">

                                            <Border Width="50" Height="50" CornerRadius="25" ClipToBounds="True" >
                                                <Image Source="avares://YHTransporte.AvaloniaUI/Assets/camion.png"
                                                Stretch="UniformToFill"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4" VerticalAlignment="Center" Margin="15,0,24,0">
                                                <TextBlock Text="{Binding Customer.Name, StringFormat='Cliente: {0}', FallbackValue='Cliente: -'}" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Dto.CreatedAt, StringFormat='Fecha de Creación: {0:dd/MM/yyyy}'}" Foreground="#8B93AF" FontSize="15"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Dto.Origin.Municipality.Name}" Foreground="#8B93AF" FontSize="15"/>
                                                    <TextBlock Text="→" Foreground="#8B93AF" FontSize="15"/>
                                                    <TextBlock Text="{Binding Dto.Destination.Municipality.Name}" Foreground="#8B93AF" FontSize="15"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Rectangle Grid.Column="2" Width="1" Fill="#323E4D" Margin="21,8"/>

                                            <StackPanel Grid.Column="3"  VerticalAlignment="Center" Spacing="6">
                                                <TextBlock Text="{Binding Supplier.Name, StringFormat='Remitente: {0}', FallbackValue='Remitente: -'}" Foreground="#8B93AF" FontSize="15" />
                                                <TextBlock Text="{Binding Dto.Description}" Foreground="#8B93AF" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

            </Grid>
        </Border>

        <UserControl Content="{Binding Creator}"  IsVisible="{Binding Creator.IsOpen}"  />
    </Grid>
</UserControl>