<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:YHTransporte.AvaloniaUI.Modules.Home.ViewModels"
	x:Class="YHTransporte.AvaloniaUI.Modules.Home.Views.HomeView"
	x:DataType="vm:HomeViewModel">
	
	<Grid RowDefinitions="60, *">
		<Border Background="#35455e" Padding="15,0" Height="60">
			<Grid ColumnDefinitions="220, *, 220">

				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="-5" VerticalAlignment="Center" HorizontalAlignment="Left">
					<Image Source="avares://YHTransporte.AvaloniaUI/Assets/Full-logo.png" Width="78" Height="45"/>
					<TextBlock Text="FAST-PACK" Foreground="White" FontWeight="Bold"
					VerticalAlignment="Center" FontSize="16"/>
				</StackPanel>
				
		
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
					VerticalAlignment="Center" x:Name="ButtonsPanel" >

					<StackPanel.Styles>
							<Style Selector="Button">
									<Setter Property="Background" Value="Transparent"/>
									<Setter Property="Foreground" Value="LightGray"/>
									<Setter Property="FontWeight" Value="Bold"/>
									<Setter Property="Padding" Value="8,5"/>
							</Style>
					</StackPanel.Styles>

					<Button x:Name="btnInicio" Content="Inicio" Command="{Binding SetDashboardMenuCommand}"/>
					<Button x:Name="btnClientes" Content="Clientes" Command="{Binding SetCustomerMenuCommand}"/>
					<Button x:Name="btnServicios" Content="Servicios"/>
					<Button x:Name="btnCargas" Content="Cargas"/>
					<Button x:Name="btnVehiculos" Content="Vehículos"/>
					<Button x:Name="btnConductores" Content="Conductores"/>
					<Button x:Name="btnRutas" Content="Rutas"/>
					<Button x:Name="btnSeguimiento" Content="Seguimiento"/>
					<Button x:Name="btnReportes" Content="Reportes"/>

				</StackPanel>

				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
						HorizontalAlignment="Right" VerticalAlignment="Center">

					<Button Background="Transparent" Padding="0">
							<Image Source="avares://YHTransporte.AvaloniaUI/Assets/12225881.png" Width="46"/>
					</Button>

					<TextBlock Text="ADMIN" VerticalAlignment="Center" 
					Foreground="White" FontWeight="Bold" FontSize="12"/>

					<Button Background="Transparent" Padding="0">
							<Image Source="avares://YHTransporte.AvaloniaUI/Assets/logout.png" Width="32"/>
					</Button>
				</StackPanel>

			</Grid>
		</Border>

		<UserControl Content="{Binding CurrentView}" Grid.Row="1"/>
	</Grid>
	
</UserControl>